<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.chart.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="javafx_demo.controller.MainController"
            prefHeight="800.0" prefWidth="1400.0"
            style="-fx-background-color: #f5f5f5;">

    <!-- Top: Header Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0"
              style="-fx-background-color: #2c3e50; -fx-padding: 12 15;">
            <Label text="打手终端" style="-fx-text-fill: white; -fx-font-weight: bold;">
                <font><Font size="18.0"/></font>
            </Label>
            <Region HBox.hgrow="ALWAYS"/>
            <!-- 快捷操作 -->
            <Button fx:id="findingRequestBtn" text="创建找单请求" onAction="#handleFindingRequest"
                    style="-fx-background-color: #1219f3; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 5; -fx-padding: 8 18;">
                <font><Font size="13.0"/></font>
            </Button>
            <Button fx:id="acceptOrderBtn" text="就绪" onAction="#handleAcceptOrder"
                    style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 5; -fx-padding: 8 18;">
                <font><Font size="13.0"/></font>
            </Button>
            <Button fx:id="hangingBtn" text="挂起" onAction="#handleHanging"
                    style="-fx-background-color: #e58e15; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 5; -fx-padding: 8 18;">
                <font><Font size="13.0"/></font>
            </Button>
            <Button fx:id="offlineBtn" text="离线" onAction="#handleOffline"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 5; -fx-padding: 8 18;">
                <font><Font size="13.0"/></font>
            </Button>
            <Separator orientation="VERTICAL" style="-fx-padding: 0 5;"/>
            <Label fx:id="userStatusLabel" text="● 在线" style="-fx-text-fill: white;">
                <font><Font size="13.0"/></font>
            </Label>
            <Label fx:id="usernameLabel" text="用户名" style="-fx-text-fill: white;">
                <font><Font size="14.0"/></font>
            </Label>
            <Button fx:id="logoutButton" text="退出" onAction="#handleLogout"
                    style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 5; -fx-padding: 8 15;">
                <font><Font size="12.0"/></font>
            </Button>
        </HBox>
    </top>

    <!-- Left: Navigation Menu -->
    <left>
        <VBox spacing="5.0" style="-fx-background-color: white; -fx-padding: 10;" prefWidth="180.0">
            <Label text="导航菜单" style="-fx-font-weight: bold; -fx-padding: 10 0 10 10;">
                <font><Font size="14.0"/></font>
            </Label>
            <Separator/>
            <Button fx:id="dashboardBtn" text="工单列表" onAction="#showDashboard" maxWidth="Infinity"
                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-padding: 10;">
                <font><Font size="13.0"/></font>
            </Button>
            <Button fx:id="bookOrderBtn" text="存单" onAction="#showBookOrders" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #2c3e50; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-padding: 10;">
                <font><Font size="13.0"/></font>
            </Button>
            <Button fx:id="dataManageBtn" text="统计" onAction="#showStatistics" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #2c3e50; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-padding: 10;">
                <font><Font size="13.0"/></font>
            </Button>
            <Button fx:id="settingsBtn" text="我的" onAction="#showSettings" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #2c3e50; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-padding: 10;">
                <font><Font size="13.0"/></font>
            </Button>
        </VBox>
    </left>

    <!-- Center: StackPane (多视图切换，解决跳转 bug) -->
    <center>
        <StackPane fx:id="contentStack" style="-fx-background-color: white;">

            <!-- 视图 1: 首页（上：找单列表+空白 / 下：工单列表） -->
            <VBox fx:id="orderPane" spacing="10.0" style="-fx-padding: 15;">

                <!-- 上半部分: 找单请求(左) + 空白区域(右) -->
                <HBox spacing="15.0" VBox.vgrow="ALWAYS">
                    <!-- 左: 找单请求列表 -->
                    <VBox spacing="8.0" HBox.hgrow="ALWAYS"
                          style="-fx-border-color: #ddd; -fx-border-radius: 5; -fx-padding: 10; -fx-background-color: #fafafa; -fx-background-radius: 5;">
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <Label text="找单请求" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="refreshFindingBtn" text="刷新" onAction="#handleRefreshFinding"
                                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 3; -fx-padding: 4 12; -fx-font-size: 11;"/>
                        </HBox>
                        <TableView fx:id="findingTable" VBox.vgrow="ALWAYS"
                                   style="-fx-font-size: 12;">
                            <columns>
                                <TableColumn fx:id="findingManCol" text="性别" prefWidth="60" style="-fx-alignment: CENTER;"/>
                                <TableColumn fx:id="findingDescCol" text="需求描述" prefWidth="150" style="-fx-alignment: CENTER;"/>
                                <TableColumn fx:id="findingTimeCol" text="请求时间" prefWidth="80" style="-fx-alignment: CENTER;"/>
                                <TableColumn fx:id="findingStatusCol" text="状态" prefWidth="70" style="-fx-alignment: CENTER;"/>
                                <TableColumn fx:id="findingActionCol" text="操作" prefWidth="60" style="-fx-alignment: CENTER;"/>
                            </columns>
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                        </TableView>
                    </VBox>
                    <!-- 右: 预留空白 -->
                    <VBox HBox.hgrow="ALWAYS" style="-fx-border-color: #eee; -fx-border-radius: 5; -fx-border-style: dashed; -fx-padding: 10; -fx-background-radius: 5;">
                    </VBox>
                </HBox>

                <!-- 下半部分: 工单列表 -->
                <VBox spacing="8.0" VBox.vgrow="ALWAYS"
                      style="-fx-border-color: #ddd; -fx-border-radius: 5; -fx-padding: 10; -fx-background-color: #fafafa; -fx-background-radius: 5;">
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label text="今日工单" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="refreshBtn" text="刷新" onAction="#handleRefresh"
                                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 5; -fx-padding: 6 15;"/>
                    </HBox>
                    <TableView fx:id="ordersTable" VBox.vgrow="ALWAYS"
                               style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 5;">
                        <columns>
                            <TableColumn fx:id="idCol" text="工单ID" prefWidth="130" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="typeCol" text="服务类型" prefWidth="100" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="gameTypeCol" text="游戏" prefWidth="80" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="rankCol" text="段位" prefWidth="80" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="customerCol" text="客户" prefWidth="100" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="statusCol" text="状态" prefWidth="100" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="amountCol" text="数量" prefWidth="80" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="unitCol" text="单位" prefWidth="60" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="incomeCol" text="结算价" prefWidth="80" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="issueDateCol" text="创建时间" prefWidth="150" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="actionCol" text="操作" prefWidth="220" style="-fx-alignment: CENTER;"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </VBox>

            </VBox>

            <!-- 视图 2: 存单列表 -->
            <VBox fx:id="bookOrderPane" spacing="10.0" visible="false" style="-fx-padding: 15;">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="存单列表" style="-fx-font-weight: bold; -fx-font-size: 16;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="addBookOrderBtn" text="新增" onAction="#handleAddBookOrder"
                            style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 5; -fx-padding: 6 15;"/>
                    <Button fx:id="refreshBookOrderBtn" text="刷新" onAction="#handleRefreshBookOrders"
                            style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 5; -fx-padding: 6 15;"/>
                </HBox>
                <TableView fx:id="bookOrdersTable" VBox.vgrow="ALWAYS"
                           style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 5;">
                    <columns>
                        <TableColumn fx:id="boCustomerCol" text="客户备注" prefWidth="100" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="boCustomerIdCol" text="微信号" prefWidth="100" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="boDetailsCol" text="客户描述" prefWidth="150" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="boAmountCol" text="存单数量" prefWidth="80" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="boRemainingCol" text="剩余时间" prefWidth="80" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="boPriceCol" text="存单总价" prefWidth="80" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="boPicCol" text="图片" prefWidth="60" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="boCreateTimeCol" text="创建时间" prefWidth="150" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="boActionCol" text="操作" prefWidth="280" style="-fx-alignment: CENTER;"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
                <HBox fx:id="bookOrderPagination" alignment="CENTER" spacing="10.0" style="-fx-padding: 8 0 0 0;">
                    <Button fx:id="boPrevPageBtn" text="上一页" onAction="#handleBoPrevPage"
                            style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 4 12; -fx-background-radius: 3;"/>
                    <Label fx:id="boPageLabel" text="第 1 页 / 共 1 页"/>
                    <Button fx:id="boNextPageBtn" text="下一页" onAction="#handleBoNextPage"
                            style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 4 12; -fx-background-radius: 3;"/>
                </HBox>
            </VBox>

            <!-- 视图 3: 统计 -->
            <ScrollPane fx:id="statsPane" fitToWidth="true" visible="false"
                        style="-fx-background-color: #f5f5f5; -fx-border-color: transparent;">
                <VBox spacing="18.0" style="-fx-padding: 25 30;">

                    <Label text="我的统计" style="-fx-font-weight: bold; -fx-font-size: 20; -fx-text-fill: #2c3e50;"/>

                    <!-- 汇总卡片 -->
                    <HBox spacing="15.0">
                        <VBox alignment="CENTER" spacing="6.0" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: #ebf5fb; -fx-padding: 20 25; -fx-background-radius: 10;">
                            <Label text="当期总收入" style="-fx-text-fill: #7f8c8d; -fx-font-size: 13;"/>
                            <Label fx:id="statTotalIncomeLabel" text="--"
                                   style="-fx-text-fill: #2980b9; -fx-font-weight: bold; -fx-font-size: 30;"/>
                        </VBox>
                        <VBox alignment="CENTER" spacing="6.0" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: #eafaf1; -fx-padding: 20 25; -fx-background-radius: 10;">
                            <Label text="工作时长 (h)" style="-fx-text-fill: #7f8c8d; -fx-font-size: 13;"/>
                            <Label fx:id="statTotalCountLabel" text="--"
                                   style="-fx-text-fill: #27ae60; -fx-font-weight: bold; -fx-font-size: 30;"/>
                        </VBox>
                        <VBox alignment="CENTER" spacing="6.0" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: #fef9e7; -fx-padding: 20 25; -fx-background-radius: 10;">
                            <Label text="统计起始" style="-fx-text-fill: #7f8c8d; -fx-font-size: 13;"/>
                            <Label fx:id="statPeriodLabel" text="--"
                                   style="-fx-text-fill: #d68910; -fx-font-weight: bold; -fx-font-size: 16;"/>
                        </VBox>
                    </HBox>

                    <!-- 分类收入卡片 -->
                    <HBox spacing="15.0">
                        <VBox alignment="CENTER" spacing="5.0" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: #d6eaf8; -fx-padding: 15 20; -fx-background-radius: 8;">
                            <Label text="首单收入" style="-fx-text-fill: #1a5276; -fx-font-size: 13; -fx-font-weight: bold;"/>
                            <Label fx:id="statFirstIncomeLabel" text="--"
                                   style="-fx-text-fill: #1f618d; -fx-font-weight: bold; -fx-font-size: 22;"/>
                            <Label fx:id="statFirstCountLabel" text="--h"
                                   style="-fx-text-fill: #5d6d7e; -fx-font-size: 12;"/>
                        </VBox>
                        <VBox alignment="CENTER" spacing="5.0" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: #d5f5e3; -fx-padding: 15 20; -fx-background-radius: 8;">
                            <Label text="续单收入" style="-fx-text-fill: #1d6a39; -fx-font-size: 13; -fx-font-weight: bold;"/>
                            <Label fx:id="statRenewalIncomeLabel" text="--"
                                   style="-fx-text-fill: #1e8449; -fx-font-weight: bold; -fx-font-size: 22;"/>
                            <Label fx:id="statRenewalCountLabel" text="--h"
                                   style="-fx-text-fill: #5d6d7e; -fx-font-size: 12;"/>
                        </VBox>
                        <VBox alignment="CENTER" spacing="5.0" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: #fdebd0; -fx-padding: 15 20; -fx-background-radius: 8;">
                            <Label text="其他收入" style="-fx-text-fill: #7b5300; -fx-font-size: 13; -fx-font-weight: bold;"/>
                            <Label fx:id="statOtherIncomeLabel" text="--"
                                   style="-fx-text-fill: #9a4e0b; -fx-font-weight: bold; -fx-font-size: 22;"/>
                            <Label fx:id="statOtherCountLabel" text="--h"
                                   style="-fx-text-fill: #5d6d7e; -fx-font-size: 12;"/>
                        </VBox>
                    </HBox>

                    <!-- 近7日趋势图 -->
                    <VBox spacing="8.0"
                          style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8;">
                        <Label text="近7日收入趋势"
                               style="-fx-font-weight: bold; -fx-font-size: 14; -fx-text-fill: #2c3e50;"/>
                        <LineChart fx:id="weeklyChart" prefHeight="220.0" animated="false"
                                   style="-fx-background-color: transparent;">
                            <xAxis><CategoryAxis label="日期"/></xAxis>
                            <yAxis><NumberAxis label="收入 (¥)"/></yAxis>
                        </LineChart>
                    </VBox>

                    <!-- 当期排行 -->
                    <VBox spacing="8.0"
                          style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8;">
                        <Label text="当期排行"
                               style="-fx-font-weight: bold; -fx-font-size: 14; -fx-text-fill: #2c3e50;"/>
                        <TableView fx:id="rankingTable" prefHeight="200.0"
                                   style="-fx-background-color: white;">
                            <columns>
                                <TableColumn fx:id="rankNameCol"   text="打手"   prefWidth="200"/>
                                <TableColumn fx:id="rankIncomeCol" text="当期收入" prefWidth="150" style="-fx-alignment: CENTER-RIGHT;"/>
                                <TableColumn fx:id="rankCountCol"  text="工时(h)" prefWidth="120" style="-fx-alignment: CENTER-RIGHT;"/>
                            </columns>
                            <placeholder><Label text="暂无排行数据"/></placeholder>
                        </TableView>
                    </VBox>

                </VBox>
            </ScrollPane>

            <!-- 视图 4: 我的 -->
            <ScrollPane fx:id="settingsPane" fitToWidth="true" visible="false"
                        style="-fx-background-color: white; -fx-border-color: transparent;">
                <VBox spacing="15.0" style="-fx-padding: 15;">

                    <!-- 上半部分: 请假记录 + 工资预支 水平排列 -->
                    <HBox spacing="15.0" VBox.vgrow="NEVER">

                        <!-- 左: 请假记录 -->
                        <VBox spacing="8.0" HBox.hgrow="ALWAYS" style="-fx-border-color: #ddd; -fx-border-radius: 5; -fx-padding: 10; -fx-background-color: #fafafa; -fx-background-radius: 5;">
                            <HBox alignment="CENTER_LEFT" spacing="8.0">
                                <Label text="请假记录" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="addLeaveBtn" text="新增" onAction="#handleAddLeave"
                                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 3; -fx-padding: 4 12; -fx-font-size: 11;"/>
                                <Button fx:id="refreshLeaveBtn" text="刷新" onAction="#handleRefreshLeave"
                                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 3; -fx-padding: 4 12; -fx-font-size: 11;"/>
                            </HBox>
                            <TableView fx:id="leaveTable" prefHeight="200" style="-fx-font-size: 12;">
                                <columns>
                                    <TableColumn fx:id="leaveTypeCol" text="类型" prefWidth="60" style="-fx-alignment: CENTER;"/>
                                    <TableColumn fx:id="leaveApplyTimeCol" text="申请时间" prefWidth="130" style="-fx-alignment: CENTER;"/>
                                    <TableColumn fx:id="leaveEndTimeCol" text="截止时间" prefWidth="130" style="-fx-alignment: CENTER;"/>
                                    <TableColumn fx:id="leaveStatusCol" text="状态" prefWidth="60" style="-fx-alignment: CENTER;"/>
                                </columns>
                                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                            </TableView>
                            <HBox alignment="CENTER" spacing="8.0">
                                <Button fx:id="leavePrevBtn" text="上一页" onAction="#handleLeavePrev"
                                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 3 10; -fx-background-radius: 3; -fx-font-size: 11;"/>
                                <Label fx:id="leavePageLabel" text="第 1 页 / 共 1 页" style="-fx-font-size: 11;"/>
                                <Button fx:id="leaveNextBtn" text="下一页" onAction="#handleLeaveNext"
                                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 3 10; -fx-background-radius: 3; -fx-font-size: 11;"/>
                            </HBox>
                        </VBox>

                        <!-- 右: 工资预支记录 -->
                        <VBox spacing="8.0" HBox.hgrow="ALWAYS" style="-fx-border-color: #ddd; -fx-border-radius: 5; -fx-padding: 10; -fx-background-color: #fafafa; -fx-background-radius: 5;">
                            <HBox alignment="CENTER_LEFT" spacing="8.0">
                                <Label text="工资预支记录" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="addAdvanceBtn" text="新增" onAction="#handleAddAdvance"
                                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 3; -fx-padding: 4 12; -fx-font-size: 11;"/>
                                <Button fx:id="refreshAdvanceBtn" text="刷新" onAction="#handleRefreshAdvance"
                                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 3; -fx-padding: 4 12; -fx-font-size: 11;"/>
                            </HBox>
                            <TableView fx:id="advanceTable" prefHeight="200" style="-fx-font-size: 12;">
                                <columns>
                                    <TableColumn fx:id="advanceNameCol" text="姓名" prefWidth="80" style="-fx-alignment: CENTER;"/>
                                    <TableColumn fx:id="advanceAmountCol" text="预支金额" prefWidth="80" style="-fx-alignment: CENTER;"/>
                                    <TableColumn fx:id="advanceStatusCol" text="状态" prefWidth="60" style="-fx-alignment: CENTER;"/>
                                </columns>
                                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                            </TableView>
                            <HBox alignment="CENTER" spacing="8.0">
                                <Button fx:id="advancePrevBtn" text="上一页" onAction="#handleAdvancePrev"
                                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 3 10; -fx-background-radius: 3; -fx-font-size: 11;"/>
                                <Label fx:id="advancePageLabel" text="第 1 页 / 共 1 页" style="-fx-font-size: 11;"/>
                                <Button fx:id="advanceNextBtn" text="下一页" onAction="#handleAdvanceNext"
                                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 3 10; -fx-background-radius: 3; -fx-font-size: 11;"/>
                            </HBox>
                        </VBox>

                    </HBox>

                    <!-- 分隔线 -->
                    <Separator style="-fx-padding: 5 0;"/>

                    <!-- 下半部分: 维护记录表格(左) + 详情面板(右) -->
                    <HBox spacing="15.0" VBox.vgrow="ALWAYS">

                        <!-- 左: 维护记录表格 -->
                        <VBox spacing="8.0" prefWidth="500" minWidth="400"
                              style="-fx-border-color: #ddd; -fx-border-radius: 5; -fx-padding: 10; -fx-background-color: #fafafa; -fx-background-radius: 5;">
                            <HBox alignment="CENTER_LEFT" spacing="8.0">
                                <Label text="维护记录" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="refreshMaintBtn" text="刷新" onAction="#handleRefreshMaint"
                                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 3; -fx-padding: 4 12; -fx-font-size: 11;"/>
                            </HBox>
                            <TableView fx:id="maintTable" prefHeight="250" style="-fx-font-size: 12;">
                                <columns>
                                    <TableColumn fx:id="maintBossCol" text="老板名称" prefWidth="80" style="-fx-alignment: CENTER;"/>
                                    <TableColumn fx:id="maintWechatCol" text="微信号" prefWidth="100" style="-fx-alignment: CENTER;"/>
                                    <TableColumn fx:id="maintTimeCol" text="添加时间" prefWidth="130" style="-fx-alignment: CENTER;"/>
                                    <TableColumn fx:id="maintLogCol" text="维护记录" prefWidth="60" style="-fx-alignment: CENTER;"/>
                                </columns>
                                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                            </TableView>
                            <HBox alignment="CENTER" spacing="8.0">
                                <Button fx:id="maintPrevBtn" text="上一页" onAction="#handleMaintPrev"
                                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 3 10; -fx-background-radius: 3; -fx-font-size: 11;"/>
                                <Label fx:id="maintPageLabel" text="第 1 页 / 共 1 页" style="-fx-font-size: 11;"/>
                                <Button fx:id="maintNextBtn" text="下一页" onAction="#handleMaintNext"
                                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 3 10; -fx-background-radius: 3; -fx-font-size: 11;"/>
                            </HBox>
                        </VBox>

                        <!-- 右: 维护记录详情面板 -->
                        <VBox fx:id="maintDetailPane" spacing="8.0" HBox.hgrow="ALWAYS"
                              style="-fx-border-color: #ddd; -fx-border-radius: 5; -fx-padding: 10; -fx-background-color: #fafafa; -fx-background-radius: 5;">
                            <Label fx:id="maintDetailTitle" text="维护记录详情" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
                            <ScrollPane fx:id="maintDetailScroll" VBox.vgrow="ALWAYS"
                                        style="-fx-background-color: white; -fx-border-color: #eee; -fx-border-radius: 3;"
                                        fitToWidth="true" prefHeight="200">
                                <Label fx:id="maintDetailContent" text="请点击左侧表格中的「查看」按钮"
                                       wrapText="true" style="-fx-padding: 10; -fx-text-fill: #555; -fx-font-size: 13;"/>
                            </ScrollPane>
                            <!-- 底部: 输入框 + 按钮 -->
                            <HBox alignment="CENTER_RIGHT" spacing="8.0">
                                <TextField fx:id="maintInputField" promptText="输入维护记录（50字以内）"
                                           HBox.hgrow="ALWAYS" visible="false" managed="false"
                                           style="-fx-font-size: 12;"/>
                                <HBox fx:id="maintInputActions" spacing="4.0" visible="false" managed="false">
                                    <Button fx:id="maintConfirmBtn" text="✓" onAction="#handleMaintConfirm"
                                            style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 3; -fx-padding: 4 10; -fx-font-size: 12;"/>
                                    <Button fx:id="maintCancelBtn" text="✕" onAction="#handleMaintCancel"
                                            style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 3; -fx-padding: 4 10; -fx-font-size: 12;"/>
                                </HBox>
                                <Button fx:id="maintAddLogBtn" text="+" onAction="#handleMaintAddLog"
                                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 3; -fx-padding: 4 12; -fx-font-size: 14; -fx-font-weight: bold;"
                                        visible="false" managed="false"/>
                            </HBox>
                        </VBox>

                    </HBox>

                </VBox>
            </ScrollPane>

        </StackPane>
    </center>

    <!-- Bottom: Status Bar -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="10.0"
              style="-fx-background-color: #ecf0f1; -fx-padding: 8;">
            <Label fx:id="statusLabel" text="就绪" style="-fx-text-fill: #7f8c8d;">
                <font><Font size="12.0"/></font>
            </Label>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="versionLabel" text="Version 1.0.0" style="-fx-text-fill: #95a5a6;">
                <font><Font size="12.0"/></font>
            </Label>
        </HBox>
    </bottom>

</BorderPane>
